{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:requirements-framework:v1:core",
  "title": "Requirements framework core v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "requirements"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "pattern": "\\S"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "required": [
        "id",
        "title",
        "statement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "title": {
          "type": "string",
          "pattern": "\\S"
        },
        "statement": {
          "type": "string",
          "pattern": "\\S"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "parents": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
